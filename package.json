{
  "name": "@longjl1/mechanical-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:demo && npm run build:lib",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/clean-declarations.mjs",
    "prepare": "npm run build:lib",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "description": "Four tactile React components: Mechanical Bar, Gear Wheel, Mechanical Flip, and Spring Pull.",
  "repository": {
    "type": "git",
    "url": "https://github.com/longjl1/online-knob.git"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/index.d.ts",
  "files": [
    "dist-lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./mechanical-bar": {
      "types": "./dist-lib/types/components/mechanical-bar/index.d.ts",
      "import": "./dist-lib/mechanical-bar.js"
    },
    "./gear-wheel": {
      "types": "./dist-lib/types/components/gear-wheel/index.d.ts",
      "import": "./dist-lib/gear-wheel.js"
    },
    "./mechanical-flip": {
      "types": "./dist-lib/types/components/mechanical-flip/index.d.ts",
      "import": "./dist-lib/mechanical-flip.js"
    },
    "./spring-pull": {
      "types": "./dist-lib/types/components/spring-pull/index.d.ts",
      "import": "./dist-lib/spring-pull.js"
    },
    "./styles.css": "./dist-lib/mechanical-ui.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
